- const CNAME = 'webjam.site'

html(lang="en")
  head
    title Webjam.site domains
    meta(charset="utf8")
    meta(content="width=device-width, initial-scale=1" name="viewport")
    link(rel="icon" type="image/webp" href="images/icon-webjam-site/sm.webp")
    
    style.
      :lang(es) #lang-es {
        order: 1;
      }

      :lang(es) #lang-en {
        order: 2;
      }
      :lang(en) #lang-es {
        order: 2;
      }

      :lang(en) #lang-en {
        order: 1;
      }
      
  body[bg-gray-200 flex-cs min-h-screen p4 flex-col]
    div[font-mono flex flex-col text-9 sm:text-10 my-24 font-bold text-shadow-[0_1px_0_#fff] text-black/86]
      div[flex-cc mb6]
        div[h-12 w-12 flex-cc text-shadow-[0_1px_0_#fff]]
          span[icon-fa-users-gear text-3em]
      div *.webjam.site
    div[flex flex-col sm:flex-row gap-6 max-w-screen-md]
      mixin Message(langName, langCode)
        div[bg-white relative  rounded-2 p8 flex flex-col gap-4 w-full shadow-sm text-center text-4.5](id=`lang-${langCode}`)
          div[whitespace-nowrap absolute -top-4 h-8 flex-cc left-1/2 -translate-x-1/2 bg-black text-white rounded-2 font-mono px-2]= langName
          block

      

          
      +Message('🇺🇸 English 🇬🇧', 'en')
        div <span class="font-mono font-bold">webjam.site</span> is a domain name managed by <a href="https://ezequielschwartzman.org" class="font-mono text-sky-500 underline">Ezequiel Schwartzman</a>.
        div Websites in the  <span class="font-mono font-bold">*.webjam.site</span> subdomain belong to family, friends or clients of Ezequiel, or Ezequiel himself, and were made with  <a href="https://ezequielschwartzman.org" class="text-sky-500 underline">Web Jam</a>.
        div <span class="font-mono font-bold">webjam.site</span> is not part of the Web Jam editor (<a href="https://webjam.space" class="text-sky-500 font-mono underline">webjam.space</a>) created by Ezequiel; which is free and open source, and works locally and without a backend.

        
      +Message('🇦🇷 Español 🇪🇸', 'es')
        div <span class="font-mono font-bold">webjam.site</span> is un dominio administrado por <a href="https://ezequielschwartzman.org" class="text-sky-500 underline font-mono">Ezequiel Schwartzman</a>.
        div Los sitios web en el subdominio <span class="font-mono font-bold">*.webjam.site</span> pertenecen a familia, amigos o clientes de Ezequiel, o Ezequiel mismo.
        div <span class="font-mono font-bold">webjam.site</span> no es parte del editor de sitios Web Jam (<a href="https://webjam.space" class="text-sky-500 font-mono underline">webjam.space</a>), creado por Ezequiel; que es de utilización libre y de código abierto, y opera localmente completamente sin servidores.
  
    script.
      const language = navigator.language.split('-')[0];
  
      document.querySelectorAll('[lang]').forEach(el => {
         document.documentElement.lang = language;
      });